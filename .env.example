# ─── Supabase (required for the app to boot) ──────────────────────────────
# Find these in your Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Client-side mirrors (Lovable/Vite injects these into the browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PROJECT_ID=your-project-id

# ─── Alpaca Live Trading (required for live orders + market data) ──────────
# Find these in your Alpaca dashboard → API Keys (Live account only)
ALPACA_LIVE_KEY_ID=your-live-key-id
ALPACA_LIVE_SECRET_KEY=your-live-secret-key

# ─── Market Data (optional — used if provider is "polygon") ───────────────
# Only needed if app_settings.provider is "polygon".
# If absent, the app falls back to Alpaca's free IEX feed.
MARKET_DATA_API_KEY=your-polygon-api-key

# ─── Security / Passcode Gate ─────────────────────────────────────────────
# If SITE_PASSWORD is set, the app requires a passcode to open.
# SESSION_SECRET must be set (≥32 characters) when SITE_PASSWORD is set.
# Generate one: openssl rand -base64 48
SITE_PASSWORD=
SESSION_SECRET=

# ─── Drizzle Migrations (optional — only for drizzle-kit) ─────────────────
# Connection string for running Drizzle migrations against your database
LOVABLE_DB_MIGRATION_URL=postgresql://...
